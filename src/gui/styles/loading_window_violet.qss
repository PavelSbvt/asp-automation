#widget_background_fill {
    background-color: #2D1B3D;
    border-radius: 10px;
}

#widget_gradient {
    background: transparent;
}

#background_widget_text{
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 10px;
}

#block_app_name{
    color: #E8D5F5;
}

#citation{
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 10px;
}

#lb_blc_m_load{
    color: #B8A0C8;
    padding: 5px 10px;
}

QProgressBar {
    background-color: #3C3F41;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: white;
    font-size: 10px;
    font-weight: bold;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #2196F3,
        stop: 0.5 #42A5F5,
        stop: 1 #1E88E5
    );
    border-radius: 4px;
    margin: 1px;
}

