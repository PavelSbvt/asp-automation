QWidget#loading_window_2 {
    background-color: #1E1E1E;
}

QWidget#widget_background_fill {
    background-color: #0D0D0D;
    border-radius: 10px;
}

QWidget#widget_gradient {
    background: transparent;
}

QWidget#background_widget_text {
    background-color: rgba(180, 150, 255, 0.06);
    border-radius: 10px;
}

QWidget#citation {
    background-color: rgba(180, 150, 255, 0.06);
    border-radius: 10px;
}

QLabel#block_app_name {
    color: #E0E0E0;
    font-weight: bold;
}

QLabel#lb_blc_m_load {
    color: #A0A0A0;
    padding: 5px 10px;
}

QLabel#lb_hi_prog {
    color: #E0E0E0;
    font-weight: bold;
}

QLabel#label_text {
    color: #E0E0E0;
}

QLabel#citation_label {
    color: #E0E0E0;
    font-weight: 300;
    padding: 5px;
}

QLabel#citation_author_label {
    color: #E0E0E0;
    font-weight: 400;
    letter-spacing: 0.3px;
    padding: 7px;
}

QLine#line {
    background-color: rgba(255, 255, 255, 0.25);
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QPushButton#loading_window {
    background-color: transparent;
    border: none;
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 10px;
}

QPushButton#loading_window:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

QPushButton#loading_window:pressed {
    background-color: rgba(255, 255, 255, 0.08);
}

QProgressBar#progress_bar {
    background-color: #2A2A2A;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: #E0E0E0;
    font-size: 10px;
    font-weight: bold;
}

QProgressBar#progress_bar::chunk {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #555555,
        stop: 0.5 #777777,
        stop: 1 #444444
    );
    border-radius: 4px;
    margin: 1px;
}

QLabel#icon {
    background: transparent;
}