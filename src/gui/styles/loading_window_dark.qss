#widget_background_fill {
    background-color: #0D0D0D;
    border-radius: 10px;
}

#widget_gradient {
    background: transparent;
}

#background_widget_text {
    background-color: rgba(180, 150, 255, 0.06);
    border-radius: 10px;
}

#label_text {
    color: #E0E0E0;
}

#block_app_name {
    color: #E0E0E0;
}

#citation {
    background-color: rgba(180, 150, 255, 0.06);
    border-radius: 10px;
}

#lb_blc_m_load {
    color: #A0A0A0;
    padding: 5px 10px;
}

#citation_label {
    color: #E0E0E0;
    font-weight: 300;
    padding: 5px;
}

#citation_author_label {
    color: #E0E0E0;
    font-weight: 400;
    letter-spacing: 0.3px;
    padding: 7px;
}

#separator {
    background-color: rgba(255, 255, 255, 0.25);
    max-height: 1px;
    border: none;
}

QProgressBar {
    background-color: #2A2A2A;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: #E0E0E0;
    font-size: 10px;
    font-weight: bold;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #555555,
        stop: 0.5 #777777,
        stop: 1 #444444
    );
    border-radius: 4px;
    margin: 1px;
}
