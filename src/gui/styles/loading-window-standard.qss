#loading_window {
    background-color: transparent;
}

QWidget#loading_window_2 {
    background: transparent;
}

QWidget#widget_background_fill {
    background-color: #1E1F22;
    border-radius: 10px;
}

QWidget#widget_gradient {
    background: transparent;
}

QWidget#background_widget_text {
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 10px;
}

QWidget#citation {
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 12px;
}

QLabel#block_app_name {
    color: #D4E0E4;
    font-weight: bold;
}

QLabel#label_text {
    color: #D4E0E4;
}

QLabel#lb_hi_prog {
    color: #D4E0E4;
    font-weight: bold;
}

QLabel#lb_blc_m_load {
    color: #8F949A;
    padding: 5px 10px;
}

QLabel#citation_label {
    color: #D4E0E4;
    font-weight: 300;
    padding: 5px;
}

QLabel#citation_author_label {
    color: #8F949A;
    font-weight: 400;
    letter-spacing: 0.3px;
    padding: 7px;
}

QLabel#icon {
    background: transparent;
}

QLine#line {
    background-color: rgba(255, 255, 255, 0.25);
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QPushButton#loading_window {
    background-color: transparent;
    border: none;
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 10px;
}

QPushButton#loading_window:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

QPushButton#loading_window:pressed {
    background-color: rgba(255, 255, 255, 0.08);
}

QProgressBar#progress_bar {
    background-color: #3C3F41;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: white;
    font-size: 10px;
    font-weight: bold;
}

QProgressBar#progress_bar::chunk {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #2196F3,
        stop: 0.5 #42A5F5,
        stop: 1 #1E88E5
    );
    border-radius: 4px;
    margin: 1px;
}